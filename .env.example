# JARVIS Core — Environment Configuration
# Copy this file to .env and fill in your values

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=

# Telegram Mobile Bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_CHAT_ID=

# Security — required for voice, tools, desktop daemon, and APIs
JARVIS_ACCESS_TOKEN=change-this-to-a-long-random-secret
JARVIS_ENCRYPTION_KEY=change-this-to-another-long-random-secret
JARVIS_ADMIN_USER=tonystark
JARVIS_ADMIN_PIN=change-this-pin
JARVIS_DEFAULT_CLEARANCE=2
JARVIS_MAX_CLEARANCE=6
JARVIS_RETENTION_DAYS=30

# Voice Persona
JARVIS_VOICE_ACCENT=en-GB-RyanNeural
JARVIS_PERSONALITY_LEVEL=elite
JARVIS_MAX_SENTENCES=3

# LLM
JARVIS_LLM_MODEL=gpt-4o

# Developer Workspace (absolute path recommended on Windows)
WORKSPACE_DIR=C:/wamp64/www/jarvis/jarvis_workspace

# Home Assistant (optional)
HOME_ASSISTANT_URL=http://your-home-assistant-ip:8123
HOME_ASSISTANT_TOKEN=
HA_LIVING_LIGHT=light.living_room
HA_BEDROOM_AC=climate.bedroom
MQTT_BROKER=
MQTT_PORT=1883
MAVLINK_URL=udp:127.0.0.1:14550
ROS_DOMAIN_ID=
JARVIS_SQL_DSN=

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_INTERNAL_URL=http://localhost:8000/api/jarvis
